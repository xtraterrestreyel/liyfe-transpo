# Copy this file to ".env" for local testing. On Render, enter these under Environment.
# NEVER commit your real .env file to GitHub.

# Supabase > Project Settings > API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-keep-secret

# Stripe > Developers > API keys  (use sk_test_... until you're ready to go live)
STRIPE_SECRET_KEY=sk_test_xxx
# Stripe > Developers > Webhooks > your endpoint > Signing secret
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Google Cloud > APIs & Services > Credentials (enable "Routes API" and "Places API (New)")
GOOGLE_MAPS_SERVER_KEY=your-google-maps-server-key

# Your website address(es), comma separated, no trailing slash. First one is used for Stripe redirects.
FRONTEND_URL=https://www.yourdomain.com,https://yourdomain.com

# Google emails of staff who can open the staff dashboard (admin.html), comma separated
ADMIN_EMAILS=you@gmail.com,mom@gmail.com

COMPANY_LEGAL_NAME=Liyfe Transpo LLC

# Pricing (cents / miles)
TIER_MILES=10
TIER_PRICE_CENTS=499
MAX_MILES=40
SERVICE_FEE_CENTS=50
